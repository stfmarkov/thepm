ADDR=:8090

# Supabase Postgres — direct URL for local/migrations, pooler URI in production
DATABASE_URL=

# Supabase Auth — Go is the only client; never put these in the browser
SUPABASE_URL=
SUPABASE_PROJECT_PASSWORD=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_CONNECTION_STRING=

SUPABASE_ANON_KEY=

# Session cookies — long random string (for example: openssl rand -hex 32)
SESSION_SECRET=

