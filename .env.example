# Local listen address. Render sets PORT and this is ignored.
ADDR=:8090

# Required — Go is the only Auth client; never put these in the browser
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Direct Postgres URL (tried first). Often IPv6-only; Render needs the pooler.
SUPABASE_CONNECTION_STRING=
# Session-mode pooler (port 5432 on the pooler host), not transaction mode (6543).
SUPABASE_POOLER_STRING=

# Optional. On Render these default on (Secure cookies, gin release).
# COOKIE_SECURE=true
# GIN_MODE=release
