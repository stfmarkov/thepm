package views

templ ProjectLinks(csrf string, projectID string, links []Link, errMsg string) {
	<section class="section" id="project-links">
		<h2>Links</h2>
		if errMsg != "" {
			<p class="alert" role="alert">{ errMsg }</p>
		}
		if len(links) == 0 {
			<p class="empty">No links yet.</p>
		} else {
			<div class="stack">
				for _, g := range GroupLinks(links) {
					<div class="group">
						<h3>{ LinkKindLabel(g.Kind) }</h3>
						<div class="row-list">
							for _, l := range g.Links {
								@LinkItem(csrf, l)
							}
						</div>
					</div>
				}
			</div>
		}
		@LinkAddForm(csrf, projectID)
	</section>
}

templ LinkItem(csrf string, l Link) {
	<article class="item-block" id={ "link-" + l.ID }>
		<div class="row">
			<div class="row-main">
				<a class="row-title" href={ LinkHref(l.URL) }>{ LinkTitle(l) }</a>
			</div>
			<div class="row-actions">
				<form
					class="inline-form"
					method="post"
					action={ "/projects/" + l.ProjectID + "/links/" + l.ID + "/delete" }
					hx-post={ "/projects/" + l.ProjectID + "/links/" + l.ID + "/delete" }
					hx-confirm="Delete this link?"
					hx-target="#project-links"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button type="submit" class="btn-text btn-sm btn-danger">Delete</button>
				</form>
			</div>
		</div>
		if l.Notes != "" {
			<p class="muted">{ l.Notes }</p>
		}
		<details>
			<summary class="btn-text btn-sm">Edit</summary>
			<form
				class="stack edit-panel"
				method="post"
				action={ "/projects/" + l.ProjectID + "/links/" + l.ID }
				hx-post={ "/projects/" + l.ProjectID + "/links/" + l.ID }
				hx-confirm="Save this link?"
				hx-target="#project-links"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<label>
					Kind
					<select name="kind">
						for _, k := range LinkKinds {
							if k == l.Kind {
								<option value={ k } selected>{ LinkKindLabel(k) }</option>
							} else {
								<option value={ k }>{ LinkKindLabel(k) }</option>
							}
						}
					</select>
				</label>
				<label>
					URL
					<input type="text" name="url" required value={ l.URL }/>
				</label>
				<label>
					Label
					<input type="text" name="label" value={ l.Label }/>
				</label>
				<label>
					Notes
					<textarea name="notes">{ l.Notes }</textarea>
				</label>
				<div class="form-actions">
					<button class="btn-primary" type="submit">Save</button>
				</div>
			</form>
		</details>
	</article>
}

templ LinkAddForm(csrf string, projectID string) {
	<form
		class="inline-fields link-add"
		method="post"
		action={ "/projects/" + projectID + "/links" }
		hx-post={ "/projects/" + projectID + "/links" }
		hx-target="#project-links"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<label>
			Kind
			<select name="kind">
				for _, k := range LinkKinds {
					<option value={ k }>{ LinkKindLabel(k) }</option>
				}
			</select>
		</label>
		<label>
			Label
			<input type="text" name="label" placeholder="URL label"/>
		</label>
		<label>
			URL
			<input type="text" name="url" required placeholder="https://"/>
		</label>
		<button class="btn-primary" type="submit">Add link</button>
		<label class="span-2">
			Notes
			<textarea name="notes"></textarea>
		</label>
	</form>
}
