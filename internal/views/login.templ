package views

templ Login(csrf string, errMsg string) {
	@AuthLayout("Sign in — thepm") {
		<div class="auth-brand">
			<h1 class="logo">thepm</h1>
		</div>
		if errMsg != "" {
			<p class="alert" role="alert">{ errMsg }</p>
		}
		<form class="stack" method="post" action="/login">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<label>
				Email
				<input type="email" name="email" required autocomplete="username" placeholder="name@example.com"/>
			</label>
			<label>
				Password
				<input type="password" name="password" required autocomplete="current-password" placeholder="••••••••"/>
			</label>
			<div class="stack-tight">
				<button class="btn-primary" type="submit">Sign in</button>
				<p class="auth-switch"><a href="/register">Create an account</a></p>
			</div>
		</form>
	}
}
