package views

templ ProjectNotes(csrf string, projectID string, notes []Note, errMsg string) {
	<section id="project-notes">
		<h2>Notes</h2>
		if errMsg != "" {
			<p role="alert">{ errMsg }</p>
		}
		@NoteAddForm(csrf, projectID)
		if len(notes) == 0 {
			<p>No notes yet.</p>
		} else {
			for _, n := range notes {
				@NoteItem(csrf, n)
			}
		}
	</section>
}

templ NoteItem(csrf string, n Note) {
	<article id={ "note-" + n.ID }>
		if n.CreatedAt != "" {
			<header>
				<small>{ n.CreatedAt }</small>
			</header>
		}
		<p>{ n.Body }</p>
		<form
			method="post"
			action={ "/projects/" + n.ProjectID + "/notes/" + n.ID + "/delete" }
			hx-post={ "/projects/" + n.ProjectID + "/notes/" + n.ID + "/delete" }
			hx-confirm="Delete this note?"
			hx-target="#project-notes"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<button type="submit" class="secondary">Delete</button>
		</form>
	</article>
}

templ NoteAddForm(csrf string, projectID string) {
	<form
		method="post"
		action={ "/projects/" + projectID + "/notes" }
		hx-post={ "/projects/" + projectID + "/notes" }
		hx-target="#project-notes"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<label>
			Add a note
			<textarea name="body" required></textarea>
		</label>
		<button type="submit">Add</button>
	</form>
}
