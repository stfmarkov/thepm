package views

templ ProjectFeedback(csrf string, p Project, items []Feedback, errMsg string) {
	<section class="section" id="project-feedback">
		{{ stats := FeedbackRatingStatsFrom(items) }}
		<h2>Feedback inbox</h2>
		if errMsg != "" {
			<p class="alert" role="alert">{ errMsg }</p>
		}
		@FeedbackIngest(csrf, p)
		@FeedbackAddForm(csrf, p.ID)
		if len(items) == 0 {
			<p class="empty">No feedback yet.</p>
		} else {
			<div class="feedback-toolbar">
				if stats.Count > 0 {
					<div class="feedback-stats">
						<span class="chip chip-rating">{ stats.Average }/5</span>
						<span class="muted">{ stats.CountLabel() }</span>
					</div>
				}
				<div class="feedback-sort" role="group" aria-label="Sort feedback">
					<span class="kicker">Sort</span>
					for _, opt := range FeedbackSorts {
						if opt.Value == "newest" {
							<button type="button" class="btn-text btn-sm is-active" data-feedback-sort={ opt.Value } aria-pressed="true">{ opt.Label }</button>
						} else {
							<button type="button" class="btn-text btn-sm" data-feedback-sort={ opt.Value } aria-pressed="false">{ opt.Label }</button>
						}
					}
				</div>
			</div>
			<div class="row-list" data-feedback-list>
				for _, f := range items {
					@FeedbackItem(csrf, f)
				}
			</div>
		}
	</section>
}

templ FeedbackIngest(csrf string, p Project) {
	<div class="panel">
		<h3>API ingest credentials</h3>
		<p class="muted">Other sites POST here. They need the project id and the key. Optional website limits browser Origin.</p>
		<div class="copy-row">
			<span>Project ID</span>
			<input id="ingest-project-id" type="text" readonly value={ p.ID }/>
			<button type="button" class="btn-text btn-sm" data-copy-target="ingest-project-id">Copy</button>
		</div>
		<div class="copy-row">
			<span>Endpoint</span>
			<input id="ingest-url" type="text" readonly value={ p.IngestURL }/>
			<button type="button" class="btn-text btn-sm" data-copy-target="ingest-url">Copy</button>
		</div>
		<div class="copy-row">
			<span>Key</span>
			<input id="ingest-key" type="text" readonly value={ p.FeedbackIngestKey }/>
			<button type="button" class="btn-text btn-sm" data-copy-target="ingest-key">Copy</button>
		</div>
		<form
			class="stack-tight"
			method="post"
			action={ "/projects/" + p.ID + "/ingest-origin" }
			hx-post={ "/projects/" + p.ID + "/ingest-origin" }
			hx-target="#project-feedback"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<label>
				Website
				<input type="text" name="origin" value={ p.FeedbackOrigin } placeholder="https://myapp.com"/>
			</label>
			<div class="form-actions">
				<button class="btn-primary" type="submit">Save website</button>
			</div>
		</form>
		<form
			method="post"
			action={ "/projects/" + p.ID + "/ingest-key/rotate" }
			hx-post={ "/projects/" + p.ID + "/ingest-key/rotate" }
			hx-confirm="Rotate the ingest key? Existing forms will stop working."
			hx-target="#project-feedback"
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<button type="submit" class="btn-ghost btn-danger">Rotate key</button>
		</form>
	</div>
}

templ FeedbackItem(csrf string, f Feedback) {
	<article class="feedback-item" id={ "feedback-" + f.ID } data-rating={ f.Rating } data-received={ f.ReceivedUnix }>
		<header>
			<span class={ FeedbackSourceClass(f.Source) }>{ f.Source }</span>
			<strong>{ f.AuthorName }</strong>
			if f.AuthorEmail != "" {
				<span class="muted">{ f.AuthorEmail }</span>
			}
			if f.ReceivedAt != "" {
				<span class="kicker">{ f.ReceivedAt }</span>
			}
			if f.Rating != "" {
				<span class="chip chip-rating">{ f.Rating }/5</span>
			}
			<div class="row-actions">
				<form
					class="inline-form"
					method="post"
					action={ "/projects/" + f.ProjectID + "/feedback/" + f.ID + "/delete" }
					hx-post={ "/projects/" + f.ProjectID + "/feedback/" + f.ID + "/delete" }
					hx-confirm="Delete this feedback?"
					hx-target="#project-feedback"
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button type="submit" class="btn-text btn-sm btn-danger">Delete</button>
				</form>
			</div>
		</header>
		<p>{ f.Message }</p>
	</article>
}

templ FeedbackAddForm(csrf string, projectID string) {
	<form
		class="inline-fields feedback-add"
		method="post"
		action={ "/projects/" + projectID + "/feedback" }
		hx-post={ "/projects/" + projectID + "/feedback" }
		hx-target="#project-feedback"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<label>
			Name
			<input type="text" name="name" required/>
		</label>
		<label>
			Email
			<input type="email" name="email"/>
		</label>
		<label class="span-2">
			Message
			<textarea name="message" required placeholder="Quick manual feedback entry..."></textarea>
		</label>
		<label>
			Rating
			<select name="rating">
				<option value="">None</option>
				for _, r := range FeedbackRatings {
					<option value={ r }>{ r }</option>
				}
			</select>
		</label>
		<div class="form-actions">
			<button class="btn-primary" type="submit">Add</button>
		</div>
	</form>
}
